graph TB
    %% ═══════════════════════════════════════════════════════════════
    %% spica-cli 架构图 — 详细版（代码审计 2026-06-13）
    %% 事件: 42. 工具: 33. 技能: 14. .spica/: 11 路径.
    %%
    %% 核心架构洞察：三重消息分离
    %%   _fullHistory  → 追加不截断，会话持久化
    %%   provider.msgs → LLM API 上下文，可压缩，cache-prefix 感知
    %%   toolDefs      → 独立 `tools` API 参数 (~3,500 tokens)
    %%
    %% 系统提示词只在 provider.msgs 中（通过 setSystemPromptSplit），
    %% 从不同步到 _fullHistory。会话文件节省 ~5,500 tokens。
    %% ═══════════════════════════════════════════════════════════════

    %% ==================== 展示层 ====================
    subgraph PRES["🎨 展示层 Presentation"]
        direction TB
        TUI["<b>TUI 模式</b><br/>全屏终端 · screenManager<br/>scrollback 缓冲 · 状态栏<br/>thinking 动画 · resize 处理"]
        SIMPLE["<b>简单模式</b><br/>--no-tui / 非 TTY 回退<br/>readline 输入 · 纯文本输出"]
        CMD["<b>斜杠命令</b>（16 个处理器）<br/>/help /init /history /summary<br/>/compact /archive /view /rename<br/>/delete /clear /reset /new<br/>/checkpoint · /skill · /mcp<br/>/queue /q /undo /status"]
        IQ["<b>输入队列</b><br/>最多 50 条 · 处理期间缓冲<br/>runLoop 完成后自动排空<br/>/queue 查看 · /undo 撤销"]
        UI["<b>UI 组件</b><br/>diff 渲染 · spinner<br/>流式输出 · bracketed paste<br/>fixedBox · tableRenderer · scrollback"]
    end

    %% ==================== 应用层 ====================
    subgraph APP["⚙️ 应用层 Application"]
        direction TB

        subgraph AGENT_SUB["SpicaAgent (src/agent.ts) — EventEmitter 编排器"]
            direction TB
            AGENT_STATE["<b>AgentState 状态机</b>（src/core/AgentState.ts）<br/>6 种显式状态，验证转换<br/>uninitialized→initializing→idle↔processing<br/>  ↔compacting / interrupted<br/>替代散落的布尔标志"]
            AGENT_CORE["<b>核心循环</b><br/>runLoop(prompt, maxIter=50)<br/>  → applyPendingSummary（注入延迟摘要）<br/>  → token 检查（自适应阈值）<br/>  → startNonBlockingCompression（永不阻塞）<br/>  → callLLMWithRetry（10 次重试，指数退避）<br/>  → syncFullHistory（provider→_fullHistory）<br/>  → executeTools（并行/批处理）<br/>  → 循环直到 LLM 返回纯文本<br/>scheduleIdleCompression: 30s 不活跃定时器"]
            AGENT_MSG["<b>三重消息分离</b><br/>_fullHistory: 追加不截断，会话持久化<br/>  不变量：系统提示词仅在 provider.msgs<br/>  从不在 _fullHistory 中<br/>provider.msgs: LLM API 上下文，可压缩<br/>  syncFullHistory() → 基于索引同步<br/>toolDefs: 懒加载 `tools` API 参数"]
            AGENT_CONF["<b>工具冲突检测</b><br/>extractResourcePath() 逐工具提取<br/>detectToolConflicts() 分组<br/>顺序执行: 同文件写入<br/>并行执行: 读取 + 不同文件<br/>git: 单一 'git:repo' 资源"]
            AGENT_CLEAN["<b>消息清理器</b><br/>cleanMessages() 清理 provider 后缀<br/>保护 cache prefix 边界<br/>丢弃孤立 tool_calls<br/>write/edit 自动语法检查"]
            AGENT_PROG["<b>ProgressTracker</b>（src/core/progressTracker.ts）<br/>记录：文件变更、决策、错误、里程碑<br/>toContextBlock() → 紧凑进度摘要<br/>压缩后仍存在（与消息历史分离）"]
        end

        GATE["<b>Skill Gate</b> (src/cli/skillGate.ts)<br/>8 种意图分类<br/>SKILL HINT 系统消息注入<br/>路径匹配 · 工具白名单"]

        subgraph COMPRESS["压缩 v3 (src/core/compression.ts)"]
            direction TB
            COMP_PHASE1["<b>阶段 1 — 规则截断</b>（即时生效，永不阻塞）<br/>① 读取 cachePrefixEnd → 前缀消息免评分<br/>② 评分: user=10, write/bash=9, [COMPACTED]=10<br/>   +错误信号 +2 · 噪声惩罚 -1<br/>   +内容丰富度 +0.5 · 时间衰减 +1.0<br/>③ 分级保留（基于压缩比）<br/>   >3×: 15% 最少 10 · >2×: 25% 最少 15<br/>   >1.5×: 35% 最少 20 · 其他: 50% 最少 25<br/>   下限=10 上限=nonSystem 的 40%<br/>④ 逐角色内容限制（自适应）<br/>   user=∞ · tool=1.5× · asst+tc=1.2×<br/>   已截断 → 2× 宽松 · base=0.10×窗口<br/>⑤ llm.setMessages + restore cachePrefixEnd<br/>⑥ validateCachePrefix() 断言检查"]
            COMP_PHASE2["<b>阶段 2 — 摘要</b>（后台异步，不阻塞用户）<br/>buildSummaryPrompt(oldMessages)<br/>  user: 完整 · asst: 工具+参数<br/>  tool_result: 工具名 + 500 字符 + 错误标记<br/>validateSummaryQuality(): 拒绝空/套话摘要<br/>  ↓<br/>重度丢弃 (>50%): buildFallbackSummary 即刻<br/>  + 后台 LLM 摘要供下次使用<br/>轻度丢弃 (≤50%): 后台 Promise<br/>  → _deferredSummary → applyPendingSummary()"]
        end

        INTR["<b>中断处理器</b><br/>每个 runLoop 独立 AbortController<br/>cancelSeq 高水位标记<br/>SIGKILL 杀进程组 (-pid)<br/>ESC×2 触发 · 200ms 去抖<br/>保留部分工具结果<br/>finally 块清除 pendingCancel"]

        SESSION["<b>会话 & 归档</b> (src/utils/session.ts)<br/>两态解耦模型<br/>活跃 → .spica/session.json<br/>  saveSession(ws, agent.getMessages())<br/>  → 写入 _fullHistory（完整，永不截断）<br/>历史 → .spica/sessions/&lt;id&gt;.json<br/>  archiveSession() 生成 LLM 摘要<br/>  清理: 保留最近 50 个<br/>切换: loadSessionById → session.json"]

        SUB["<b>子代理</b> (src/tools/subAgent.ts)<br/>4 种类型，自适应超时<br/>explore: 90s→180s（只读）<br/>review: 120s→240s（+lint）<br/>fix: 180s→360s（+edit）<br/>build: 300s→600s（全部工具）<br/>超时 = 基础 + 每 100 字符 +10%<br/>最多 3 并行 · 提前退出信号<br/>worktree 隔离选项<br/>每任务模型覆盖（别名→ID）"]

        PMON["<b>ProcessMonitor</b> (src/core/ProcessMonitor.ts)<br/>PID 追踪 · 进程组强杀<br/>卡死检测（SIGKILL 升级）<br/>超时管理"]

        LEARN["<b>教训系统</b> (src/core/learnings.ts)<br/>自动检测用户纠正（6 种模式）<br/>保存 .spica/learnings/YYYY-MM-DD-topic.md<br/>注入系统提示词可变部分"]
    end

    %% ==================== 领域层 ====================
    subgraph DOMAIN["🧠 领域层 Domain"]
        direction TB

        subgraph LLM_SUB["LLMClient (src/llm/LLMClient.ts)"]
            direction TB
            LLM_CORE["<b>流式客户端</b><br/>temperature=0.3<br/>stream + reasoning 双通道<br/>速率限制: 请求/分钟 + token/分钟<br/>重试: 10 次，指数退避<br/>callLLMWithRetry() 包装器"]
            LLM_ABORT["<b>AbortSignal 去重</b><br/>linkExternalSignal(ctrl, extSig, ref)<br/>  → 先 removeEventListener 再 add<br/>  → 防止 MaxListeners 警告<br/>2 个独立槽位:<br/>  _reqHandlerRef（流式请求）<br/>  _standaloneHandlerRef（压缩）<br/>createRequestController: 序列化<br/>createStandaloneController: 可并发"]
        end

        PROV["<b>Provider</b> (OpenAICompatible.ts)<br/>单一适配器对接所有 API<br/>model: 默认 · models: 别名→ID 映射<br/>resolveModel(): 别名→ID 解析<br/><br/><b>分隔前缀缓存</b><br/>setSystemPromptSplit(stable, variable)<br/>  message[0] = stable（AGENTS.md, ~3,800 tok）<br/>  message[1] = variable（skills, learnings）<br/>  cachePrefixEnd = 1（系统消息）<br/>generate() 首次调用自动标记边界<br/>  若 prefixEnd==-1 → 标记全部历史<br/>setMessages() 重置 prefixEnd 为仅系统消息<br/>  → 压缩现在会恢复它（v3 修复）<br/><br/>generate 时清理消息: 前缀保护<br/>  后缀由 cleanMessages() 清理"]

        subgraph TOKEN_SUB["TokenCounter + 上下文管理"]
            direction TB
            TOK_COUNT["<b>TokenCounter</b> (src/llm/TokenCounter.ts)<br/>tiktoken 真实分词器 (o200k_base)<br/>estimateMessages() · estimateText()<br/>每模型上下文窗口解析<br/>精确匹配 → 前缀匹配 → 128K 默认"]
            TOK_COMP["<b>压缩触发条件</b><br/>自适应阈值（按上下文窗口）：<br/>  <32K: 50% · 32-64K: 55%<br/>  64-200K: 60% · >200K: 65%<br/>  目标 = 35-40% of contextWindow<br/>触发：自动（超阈值）+ 空闲（30s）<br/>  + 手动（/compact）<br/>非阻塞：阶段 1 即时，阶段 2 后台"]
        end

        TOOLS["<b>33 个工具</b> (registry.ts + impl/)<br/><br/>📁 <b>文件 (11)</b>: read write edit file_multi_edit<br/>  file_replace file_insert file_delete file_copy<br/>  file_move file_exists file_patch<br/>🔍 <b>搜索 (4)</b>: glob grep directory_list directory_create<br/>💻 <b>Shell (5)</b>: bash(沙箱) monitor task_stop git workspace<br/>✅ <b>质量 (5)</b>: lint test format code_health test_quality_check<br/>🌐 <b>Web (3)</b>: web_search web_fetch gh<br/>📋 <b>任务 (5)</b>: todo_write todo_read task skill question<br/><br/><b>自动功能</b><br/>语法检查（tsc/py_compile/bash -n）<br/>懒加载: 16 工具首次调用时加载<br/>  省 ~1,500 tok/调用 · 首次执行时提升<br/>工具缓存: 30s TTL · 沙箱: bwrap<br/>工具分析: .spica/tool-usage.json<br/>replace_all 检测 · 8K 输出截断"]

        MCP["<b>MCP 客户端</b> (src/mcp/client.ts)<br/>@modelcontextprotocol/sdk<br/>外部工具服务器<br/>内置: playwright"]

        HOOKS["<b>Hooks 系统</b> (src/hooks/index.ts)<br/>PreToolUse / PostToolUse<br/>动作: block · confirm · warn · log<br/>全局 (~/.spica/hooks.json)<br/>项目 (.spica/hooks.json)<br/>项目严格度 ≤ 全局"]

        SKILLS["<b>14 个内置技能</b><br/>brainstorming · systematic-debugging<br/>test-driven-development · verification<br/>executing-plans · writing-plans<br/>dispatching-parallel-agents<br/>subagent-driven-development<br/>requesting-code-review · receiving<br/>finishing-a-development-branch<br/>using-git-worktrees · writing-skills<br/>using-superpowers"]
    end

    %% ==================== 基础设施层 ====================
    subgraph INFRA["💾 基础设施层 Infrastructure"]
        direction TB
        GLOBAL["<b>~/.spica/settings.json</b><br/>providers（含模型别名）<br/>MCP servers · skills · hooks<br/>chmod 600 · .gitignore 保护"]

        ACTIVE["<b>.spica/session.json</b><br/>活跃会话（追加不截断）<br/>由 saveSession() 写入<br/>来源: agent.getMessages()<br/>  = _fullHistory（永不截断）<br/>非 provider.msgs（会被压缩）"]

        HIST["<b>.spica/sessions/&lt;id&gt;.json</b><br/>历史会话 · 每次归档一份<br/>归档时生成 LLM 摘要<br/>自动清理: 保留 50"]

        STATE["<b>.spica/state.json</b><br/>项目状态<br/>todos / decisions / checkpoints"]

        TASKS["<b>.spica/tasks.json</b><br/>持久化任务列表<br/>启动时自动恢复"]

        LEARNINGS["<b>.spica/learnings/</b><br/>YYYY-MM-DD-topic.md<br/>用户纠正持久化<br/>自动注入（可变提示词）"]

        SNAPS["<b>.spica/snapshots/</b><br/>checkpoint 文件快照<br/>仅已变更文件 · 不污染 git<br/>自动清理: 保留 20"]

        CHKJSON["<b>.spica/checkpoints.json</b><br/>元数据索引<br/>id / timestamp / files / preview"]

        TOOLUSAGE["<b>.spica/tool-usage.json</b><br/>每工具调用计数<br/>辅助懒加载决策"]
        BACKUPS["<b>.spica/backups/</b><br/>write/edit 自动创建<br/>带时间戳的单文件副本"]

        PSKILLS["<b>.spica/skills.json<br/>.spica/skills/</b><br/>项目级技能覆盖<br/>SKILL.md 目录格式"]

        PHOOKS["<b>.spica/hooks.json</b><br/>项目级 hooks 覆盖<br/>严格度 ≥ 全局"]
    end

    %% ==================== 数据流图例 ====================
    subgraph LEGEND["📐 数据流图例"]
        direction LR
        L1["─── 控制流"]
        L2["<--> 双向"]
        L3["- -→ 异步/Promise"]
    end

    %% ==================== 连线 ====================

    %% 展示层 → 应用层
    TUI --> IQ
    SIMPLE --> IQ
    CMD --> AGENT_CORE
    IQ --> AGENT_CORE

    %% Agent ↔ LLM（双向，核心循环）
    AGENT_CORE <--> LLM_CORE
    PROV --> LLM_CORE
    TOK_COUNT --> LLM_CORE
    TOK_COMP --> LLM_CORE
    LLM_CORE --> AGENT_CORE
    LLM_ABORT --> LLM_CORE

    %% Agent → 工具 → Agent
    AGENT_CORE --> TOOLS
    MCP --> TOOLS
    TOOLS --> AGENT_CORE

    %% Agent → 事件 → UI
    AGENT_CORE --> EVENTS
    EVENTS --> UI

    %% 中断路径
    INTR --> AGENT_CORE
    INTR --> LLM_ABORT

    %% 压缩子系统
    AGENT_CORE --> COMP_PHASE1
    COMP_PHASE1 --> COMP_PHASE2
    TOK_COMP --> COMP_PHASE1
    COMP_PHASE2 -.-> AGENT_CORE

    %% 会话流
    AGENT_CORE --> SESSION
    AGENT_MSG --> SESSION
    SESSION --> ACTIVE
    ACTIVE --> HIST

    %% 子代理（双向）
    AGENT_CORE --> SUB
    SUB --> AGENT_CORE

    %% 进程监控
    AGENT_CORE --> PMON

    %% 教训 → 系统提示词
    LEARN --> AGENT_CORE

    %% Skill Gate
    GATE --> AGENT_CORE

    %% Hooks + Skills（拦截工具调用）
    HOOKS --> AGENT_CORE
    HOOKS --> TOOLS
    SKILLS --> AGENT_CORE
    SKILLS --> TOOLS

    %% 基础设施连线
    GLOBAL --> LLM_CORE
    GLOBAL --> PROV
    AGENT_CORE --> STATE
    AGENT_CORE --> TASKS
    SESSION --> HIST
    LEARN --> LEARNINGS

    %% Checkpoints
    AGENT_CORE --> SNAPS
    SNAPS --> CHKJSON

    %% 备份
    TOOLS --> BACKUPS

    %% 项目配置覆盖
    PSKILLS --> SKILLS
    PHOOKS --> HOOKS
