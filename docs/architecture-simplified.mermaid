graph TB
    %% ═══════════════════════════════════════════════════════
    %% spica-cli Architecture — Simplified Version
    %% Focus: core data flows, key invariants, compression lifecycle
    %% Updated 2026-06-16: 4-layer waterfall, recency markers, multi-skill, interrupt fixes
    %% ═══════════════════════════════════════════════════════

    subgraph UI["🖥️ Interface"]
        TUI["TUI / Simple Mode"]
        CMD["16 Slash Commands"]
        IQ["Input Queue (max 50)"]
    end

    subgraph AGENT["⚙️ SpicaAgent — Core Loop"]
        direction TB
        LOOP["<b>runLoop()</b><br/>1. token check → compress if >threshold<br/>2. callLLMWithRetry (10×)<br/>3. syncFullHistory<br/>4. executeTools (reads→writes→neutral)<br/>5. continueWithAllToolResults<br/>6. mid-loop compress (every 4 rounds)<br/>7. loop: tool_calls → continue; stop → exit<br/><br/>+ Stagnation Detection (16/32 rounds)<br/>+ ProgressTracker (persisted, survives compression)<br/>+ periodic save (every 5 rounds)<br/>+ save on SIGINT/interrupt"]
        MSG["<b>Three-Way Message Split</b><br/>_fullHistory → session persistence (untouched)<br/>provider.msgs → LLM context (compressed)<br/>toolDefs → lazy-loaded API tools param<br/>INVARIANT: system prompts only in provider"]
        SYNC["<b>syncFullHistory()</b><br/>index-based: provider→_fullHistory<br/>prevents desync from cleanMessages()"]
    end

    subgraph COMPRESS["🗜️ Compression — 4-Layer Waterfall"]
        direction LR
        L1["<b>L1: Snip</b> (zero cost)<br/>remove empty tool results<br/>strip orphaned tool_calls"]
        L2["<b>L2: Microcompact</b> (zero cost)<br/>truncate tool results >20K"]
        L3["<b>L3: Collapse</b> (1 API)<br/>LLM summary of middle<br/>preserve last user + tail"]
        L4["<b>L4: AutoCompact</b> (1 API)<br/>full head LLM summary<br/>+[CONTEXT COMPRESSED] signal<br/>+recency markers [OLD]/[LATEST]"]
        L1 --> L2 --> L3 --> L4
        L4 -.->|"continuation signal"| LOOP
    end

    subgraph LLM["🧠 LLMClient + Provider"]
        direction TB
        CLIENT["<b>LLMClient</b><br/>streaming · rate limiter · retry<br/>AbortSignal dedup (handler-refs)"]
        PROV["<b>Provider</b><br/>split-prefix caching<br/>msg[0]=stable · msg[1]=variable<br/>cachePrefixEnd restored + validated"]
        TOKEN["<b>TokenCounter</b><br/>tiktoken · adaptive thresholds<br/><32K:55% · 32-64K:70%<br/>64-200K:80% · ≥200K:85%"]
    end

    subgraph TOOLS["🔧 Tools (33)"]
        FILE["File (11) + Search (4)"]
        SHELL["Shell (5): bash(sandbox) + git"]
        QA["Quality (5) + Web (3) + Task (5)<br/>lazy loading: 16 tools on first use"]
    end

    subgraph STORAGE["💾 Persistence"]
        ACTIVE["session.json<br/>← _fullHistory + progress<br/>(never truncated, auto-saved<br/>every 5 tool rounds)"]
        HIST["sessions/&lt;id&gt;.json<br/>LLM summary on archive"]
        OTHER["state.json · tasks.json · tool-usage.json<br/>checkpoints.json · snapshots/<br/>backups/ · learnings/"]
    end

    %% Edges
    TUI --> IQ
    CMD --> LOOP
    IQ --> LOOP

    LOOP <--> CLIENT
    PROV --> CLIENT
    TOKEN --> CLIENT
    LOOP --> L1
    TOKEN --> L1

    LOOP --> TOOLS
    TOOLS --> LOOP

    MSG --> SYNC
    SYNC --> ACTIVE
    LOOP --> ACTIVE
    ACTIVE --> HIST
