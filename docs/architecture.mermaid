graph TB
    %% ═══════════════════════════════════════════════════════════════
    %% spica-cli Architecture — Detailed Version (code-audited 2026-06-14)
    %% Events: 42. Tools: 33. Skills: 14. .spica/: 11 paths.
    %%
    %% Key architectural insight: Three-way message split
    %%   _fullHistory  → append-only, never truncated, session persistence
    %%   provider.msgs → LLM API context, compressed, cache-prefix aware
    %%   toolDefs      → sent as separate `tools` API parameter (~3,500 tokens)
    %%
    %% System prompt is ONLY in provider.msgs (via setSystemPromptSplit),
    %% never synced to _fullHistory. This saves ~5,500 tokens in session files.
    %%
    %% 2026-06-14 audit fixes (23 issues resolved):
    %%   • ProgressTracker fully wired (errors, milestones) + persisted in session
    %%   • Stagnation detection (8/16 rounds) replaces 50-round hard cap
    %%   • Periodic session save every 5 tool rounds for crash resilience
    %%   • Skill Gate removed (dead code after PR #6)
    %%   • scoreMessage uses toolIdToName map (not fragile content matching)
    %% ═══════════════════════════════════════════════════════════════

    %% ==================== PRESENTATION LAYER ====================
    subgraph PRES["🎨 Presentation Layer"]
        direction TB
        TUI["<b>TUI Mode</b><br/>full-screen terminal · screenManager<br/>scrollback buffer · status bar<br/>thinking animation · resize handling"]
        SIMPLE["<b>Simple Mode</b><br/>--no-tui / non-TTY fallback<br/>readline input · plain text output"]
        CMD["<b>Slash Commands</b> (16 handlers)<br/>/help /init /history /summary<br/>/compact /archive /view /rename<br/>/delete /clear /reset /new<br/>/checkpoint · /skill · /mcp<br/>/queue /q /undo /status"]
        IQ["<b>Input Queue</b><br/>max 50 entries<br/>buffers during agent processing<br/>auto-drain after runLoop completes<br/>/queue show · /undo remove last"]
        UI["<b>UI Components</b><br/>diff renderer · spinner<br/>streaming output · bracketed paste<br/>fixedBox · tableRenderer · scrollback"]
    end

    %% ==================== APPLICATION LAYER ====================
    subgraph APP["⚙️ Application Layer"]
        direction TB

        subgraph AGENT_SUB["SpicaAgent (src/agent.ts) — EventEmitter Orchestrator"]
            direction TB
            AGENT_STATE["<b>AgentState Machine</b> (src/core/AgentState.ts)<br/>6 explicit states with validated transitions<br/>uninitialized→initializing→idle↔processing<br/>  ↔compacting / interrupted<br/>Replaces scattered booleans (_initialized,<br/>_compacting, pendingCancel, _initPromise)"]
            AGENT_CORE["<b>Core Loop</b><br/>runLoop(prompt)<br/>  → applyPendingSummary (inject deferred)<br/>  → token check (adaptive threshold by window)<br/>  → startNonBlockingCompression (never blocks)<br/>  → callLLMWithRetry (10 retries, exp backoff)<br/>  → syncFullHistory (provider→_fullHistory)<br/>  → executeTools (parallel/batch: reads→writes→neutral)<br/>  → continueWithAllToolResults<br/>  → loop until LLM text or stagnation<br/><b>Stagnation Detection</b> (8/16 rounds)<br/>  broad check: file write/edit/delete + bash<br/>  (test/build/install) + git + web_fetch<br/>  8 rounds no progress → warn · 16 → stop<br/>  replaces 50-round hard cap<br/><b>ProgressTracker</b> records: file changes,<br/>  errors, milestones (test pass, build, commit)<br/>  persisted in session.json · survives compression<br/><b>Periodic Save</b>: session.json every 5 tool rounds<br/><b>Idle Compression</b>: 30s inactivity timer"]
            AGENT_MSG["<b>Three-Way Message Split</b><br/>_fullHistory: append-only, session persistence<br/>  getMessages() → _fullHistory<br/>  INVARIANT: system prompts live ONLY in<br/>  provider.msgs, NEVER in _fullHistory<br/>provider.msgs: LLM API context, compressed<br/>  getContextMessages() → provider.getMessages()<br/>  syncFullHistory() → index-based sync<br/>toolDefs: lazy-loaded `tools` API param"]
            AGENT_CONF["<b>Tool Conflict Detection</b><br/>extractResourcePath() per tool<br/>detectToolConflicts() grouping<br/>sequential: same-file writes<br/>parallel: reads + different files<br/>git: single 'git:repo' resource"]
            AGENT_CLEAN["<b>Message Cleaner</b><br/>cleanMessages() on provider suffix<br/>preserves cache prefix boundary<br/>drops orphaned tool_calls<br/>auto-syntax-check on write/edit"]
            AGENT_PROG["<b>ProgressTracker</b> (src/core/progressTracker.ts)<br/>records: file changes, errors, milestones<br/>toContextBlock() → compact progress summary<br/>persisted in session.json · restored on init<br/>survives compression (separate from msg history)"]
        end



        subgraph COMPRESS["Compression v3 (src/core/compression.ts)"]
            direction TB
            COMP_PHASE1["<b>Phase 1 — Rule Truncation</b> (instant, never blocks)<br/>① Read cachePrefixEnd → exempt prefix msgs<br/>② Build toolIdToName map (accurate tool scoring)<br/>③ Score: user=10, write/bash/git=9, [COMPACTED]=10<br/>   +error signals +2 · noise penalty -1<br/>   +content richness +0.5 · recency +1.0<br/>   tool msgs scored by toolId lookup (not content)<br/>④ Graduated keep tiers (ratio-based)<br/>   >3×: 15% min 10 · >2×: 25% min 15<br/>   >1.5×: 35% min 20 · else: 50% min 25<br/>   floor=10 cap=40% of nonSystem<br/>⑤ Per-role content limits (adaptive)<br/>   user=∞ · tool=1.5× · asst+tc=1.2×<br/>   already-truncated → 2× lenient<br/>   base=0.10×contextWindow (~4K chars)<br/>⑥ llm.setMessages([...sys, ...cleaned])<br/>⑦ Restore cachePrefixEnd + validateCachePrefix()"]
            COMP_PHASE2["<b>Phase 2 — Summary</b> (background, non-blocking)<br/>buildSummaryPrompt(oldMessages)<br/>  user msgs: full · asst: tools+key args<br/>  tool_result: name + 500 chars + error tag<br/>validateSummaryQuality(): reject empty/boilerplate<br/>  ↓<br/>Heavy drop (>50%): buildFallbackSummary NOW<br/>  + background LLM summary for next request<br/>Light drop (≤50%): background promise<br/>  → _deferredSummary → applyPendingSummary()"]
        end

        INTR["<b>Interrupt Handler</b><br/>AbortController per runLoop<br/>cancelSeq high-water mark<br/>SIGKILL to process group (-pid)<br/>ESC×2 trigger · 200ms debounce<br/>preserves partial tool results<br/>clears pendingCancel in finally block"]

        SESSION["<b>Session & Archive</b> (src/utils/session.ts)<br/>two-state model (decoupled)<br/>active → .spica/session.json<br/>  saveSession(ws, messages, name, progress)<br/>  → writes _fullHistory (full, never truncated)<br/>  → merges ProgressTracker snapshot<br/>  auto-save every 5 tool rounds (crash resilience)<br/>historical → .spica/sessions/&lt;id&gt;.json<br/>  archiveSession() generates LLM summary<br/>  cleanup: keep max 50 sessions<br/>switching: loadSessionById → session.json<br/>restore: ProgressTracker.fromJSON() on init"]

        SUB["<b>Sub-Agents</b> (src/tools/subAgent.ts)<br/>4 types with adaptive timeouts<br/>explore: 90s→180s (read-only)<br/>review: 120s→240s (+lint)<br/>fix: 180s→360s (+edit)<br/>build: 300s→600s (all tools)<br/>timeout = base + 10%/100chars<br/>max 3 parallel · early-exit signal<br/>worktree isolation option<br/>per-task model override (alias→ID)"]

        PMON["<b>ProcessMonitor</b> (src/core/ProcessMonitor.ts)<br/>PID tracking · process group kill<br/>stuck detection (SIGKILL escalation)<br/>timeout management"]

        LEARN["<b>Learnings System</b> (src/core/learnings.ts)<br/>auto-detects user corrections (6 patterns)<br/>saves .spica/learnings/YYYY-MM-DD-topic.md<br/>injected into system prompt variable part"]
    end

    %% ==================== DOMAIN LAYER ====================
    subgraph DOMAIN["🧠 Domain Layer"]
        direction TB

        subgraph LLM_SUB["LLMClient (src/llm/LLMClient.ts)"]
            direction TB
            LLM_CORE["<b>Streaming Client</b><br/>temperature=0.3<br/>stream + reasoning dual channels<br/>rate limiter: req/min + tok/min<br/>retry: 10 attempts, exp backoff<br/>callLLMWithRetry() wrapper"]
            LLM_ABORT["<b>AbortSignal Dedup</b><br/>linkExternalSignal(ctrl, extSig, ref)<br/>  → removeEventListener before add<br/>  → prevents MaxListeners warning<br/>2 independent slots:<br/>  _reqHandlerRef (streaming requests)<br/>  _standaloneHandlerRef (compression)<br/>createRequestController: serialized<br/>createStandaloneController: concurrent"]
        end

        PROV["<b>Provider</b> (OpenAICompatible.ts)<br/>Single adapter for all APIs<br/>model: default · models: alias→ID map<br/>resolveModel(): alias→ID resolution<br/><br/><b>Split-Prefix Caching</b><br/>setSystemPromptSplit(stable, variable)<br/>  message[0] = stable (AGENTS.md, ~3,800 tok)<br/>  message[1] = variable (skills, learnings)<br/>  cachePrefixEnd = 1 (system msgs)<br/>generate() auto-marks first-call boundary<br/>  if prefixEnd==-1 → mark entire history<br/>setMessages() RESETS prefixEnd to sys-only<br/>  → compression restores it<br/>validateCachePrefix(): runtime invariant check<br/><br/>msg cleanup on generate: prefix preserved<br/>  suffix cleaned by cleanMessages()"]

        subgraph TOKEN_SUB["TokenCounter + Context Management"]
            direction TB
            TOK_COUNT["<b>TokenCounter</b> (src/llm/TokenCounter.ts)<br/>tiktoken real tokenizer (o200k_base)<br/>estimateMessages() · estimateText()<br/>per-model context window resolution<br/>exact match → prefix match → 128K default"]
            TOK_COMP["<b>Compression Triggers</b><br/>Adaptive thresholds by context window:<br/>  <32K: 50% · 32-64K: 55%<br/>  64-200K: 60% · >200K: 65%<br/>  target = 35-40% of contextWindow<br/>Triggers: auto (>threshold) + idle (30s)<br/>  + manual (/compact)<br/>Non-blocking: Phase 1 instant, Phase 2 background"]
        end

        TOOLS["<b>33 Tools</b> (registry.ts + impl/)<br/><br/>📁 <b>File (11)</b>: read write edit file_multi_edit<br/>  file_replace file_insert file_delete file_copy<br/>  file_move file_exists file_patch<br/>🔍 <b>Search (4)</b>: glob grep directory_list directory_create<br/>💻 <b>Shell (5)</b>: bash(sandbox) monitor task_stop git workspace<br/>✅ <b>Quality (5)</b>: lint test format code_health test_quality_check<br/>🌐 <b>Web (3)</b>: web_search web_fetch gh<br/>📋 <b>Task (5)</b>: todo_write todo_read task skill question<br/><br/><b>Auto Features</b><br/>syntax check on write/edit (tsc/py_compile/bash -n)<br/>lazy tool loading: 16 tools withheld until first use<br/>  saves ~1,500 tok/call · promote on first execute<br/>tool cache: 30s TTL · sandbox: bwrap<br/>tool analytics: .spica/tool-usage.json<br/>replace_all detection · 8K output cap"]

        MCP["<b>MCP Client</b> (src/mcp/client.ts)<br/>@modelcontextprotocol/sdk<br/>external tool servers<br/>built-in: playwright"]

        HOOKS["<b>Hooks System</b> (src/hooks/index.ts)<br/>PreToolUse / PostToolUse<br/>actions: block · confirm · warn · log<br/>global (~/.spica/hooks.json)<br/>project (.spica/hooks.json)<br/>project strictness ≤ global"]

        SKILLS["<b>14 Built-in Skills</b><br/>brainstorming · systematic-debugging<br/>test-driven-development · verification<br/>executing-plans · writing-plans<br/>dispatching-parallel-agents<br/>subagent-driven-development<br/>requesting-code-review · receiving<br/>finishing-a-development-branch<br/>using-git-worktrees · writing-skills<br/>using-superpowers"]
    end

    %% ==================== INFRASTRUCTURE LAYER ====================
    subgraph INFRA["💾 Infrastructure Layer"]
        direction TB
        GLOBAL["<b>~/.spica/settings.json</b><br/>providers (with model aliases)<br/>MCP servers · skills · hooks<br/>chmod 600 · .gitignore protected"]

        ACTIVE["<b>.spica/session.json</b><br/>active session (append-only)<br/>written by saveSession()<br/>source: agent.getMessages()<br/>  = _fullHistory (never truncated)<br/>NOT provider.msgs (which is compressed)"]

        HIST["<b>.spica/sessions/&lt;id&gt;.json</b><br/>historical · one per archive<br/>LLM summary on archive<br/>auto-pruned: keep 50"]

        STATE["<b>.spica/state.json</b><br/>project state<br/>todos / decisions / checkpoints"]

        TASKS["<b>.spica/tasks.json</b><br/>persisted task list<br/>auto-restored on start"]

        LEARNINGS["<b>.spica/learnings/</b><br/>YYYY-MM-DD-topic.md<br/>user corrections persisted<br/>auto-injected (variable prompt)"]

        SNAPS["<b>.spica/snapshots/</b><br/>checkpoint file snapshots<br/>changed files only · no git pollution<br/>auto-pruned: keep 20"]

        CHKJSON["<b>.spica/checkpoints.json</b><br/>metadata index<br/>id / timestamp / files / preview"]

        TOOLUSAGE["<b>.spica/tool-usage.json</b><br/>per-tool call counts<br/>feeds lazy loading decisions"]
        BACKUPS["<b>.spica/backups/</b><br/>auto-created on write/edit<br/>timestamped single-file copies"]

        PSKILLS["<b>.spica/skills.json<br/>.spica/skills/</b><br/>project-level skill overrides<br/>SKILL.md directory format"]

        PHOOKS["<b>.spica/hooks.json</b><br/>project-level hook overrides<br/>strictness ≥ global"]
    end

    %% ==================== DATA FLOW LEGEND ====================
    subgraph LEGEND["📐 Data Flow Legend"]
        direction LR
        L1["─── Control flow"]
        L2["<--> Bidirectional"]
        L3["- -→ Async/Promise"]
    end

    %% ==================== EDGES ====================

    %% Presentation → Application
    TUI --> IQ
    SIMPLE --> IQ
    CMD --> AGENT_CORE
    IQ --> AGENT_CORE

    %% Agent ↔ LLM (bidirectional, core loop)
    AGENT_CORE <--> LLM_CORE
    PROV --> LLM_CORE
    TOK_COUNT --> LLM_CORE
    TOK_COMP --> LLM_CORE
    LLM_CORE --> AGENT_CORE
    LLM_ABORT --> LLM_CORE

    %% Agent → Tools → Agent
    AGENT_CORE --> TOOLS
    MCP --> TOOLS
    TOOLS --> AGENT_CORE

    %% Agent → Events → UI
    AGENT_CORE --> EVENTS
    EVENTS --> UI

    %% Interrupt path
    INTR --> AGENT_CORE
    INTR --> LLM_ABORT

    %% Compression subsystem
    AGENT_CORE --> COMP_PHASE1
    COMP_PHASE1 --> COMP_PHASE2
    TOK_COMP --> COMP_PHASE1
    COMP_PHASE2 -.-> AGENT_CORE

    %% Session flow
    AGENT_CORE --> SESSION
    AGENT_MSG --> SESSION
    SESSION --> ACTIVE
    ACTIVE --> HIST

    %% Sub-agents (bidirectional)
    AGENT_CORE --> SUB
    SUB --> AGENT_CORE

    %% Process monitor
    AGENT_CORE --> PMON

    %% Learnings → system prompt
    LEARN --> AGENT_CORE

    %% Skill gate removed (dead code after PR #6)

    %% Hooks + Skills (intercept)
    HOOKS --> AGENT_CORE
    HOOKS --> TOOLS
    SKILLS --> AGENT_CORE
    SKILLS --> TOOLS

    %% Infrastructure edges
    GLOBAL --> LLM_CORE
    GLOBAL --> PROV
    AGENT_CORE --> STATE
    AGENT_CORE --> TASKS
    SESSION --> HIST
    LEARN --> LEARNINGS

    %% Checkpoints
    AGENT_CORE --> SNAPS
    SNAPS --> CHKJSON

    %% Backups
    TOOLS --> BACKUPS

    %% Project config overrides
    PSKILLS --> SKILLS
    PHOOKS --> HOOKS
